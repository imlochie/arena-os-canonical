# Local defaults — copy to .env (or run `npm run dev` once; it does this).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Waveyard worker (optional). Without REDIS_URL, the app runs fine and every
# worker-gated feature (separation, analysis, export) reports honestly as
# unavailable. With Redis + the waveyard-worker running, those features are
# real. The docker-compose.yml at the repo root starts everything at once.
# REDIS_URL=redis://127.0.0.1:6379

# Separation defaults (used when a client does not specify them).
# htdemucs is the portable default; the worker supports the Demucs family.
# SEPARATION_MODEL=htdemucs
# STEM_DEVICE=cpu

# Where the web app stores Waveyard source/stem/waveform/export files.
# The worker (original packages/storage) knows this variable as
# LOCAL_STORAGE_PATH; both names are accepted. In docker compose both
# containers share one volume at /app/.data/waveyard-storage.
# WAVEYARD_STORAGE_DIR=.data/waveyard-storage

# Archive Assistant bridge (optional, GET-only). Must be set explicitly on
# the server; there is no localhost fallback, ever.
# ARCHIVE_ASSISTANT_API_URL=https://archive-assistant.example.com/api
