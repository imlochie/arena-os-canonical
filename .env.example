# Core
NODE_ENV=development
APP_URL=http://localhost:3000
SESSION_SECRET=replace-with-at-least-32-random-characters
DATABASE_URL=postgresql://waveyard:waveyard@localhost:5432/waveyard
REDIS_URL=redis://localhost:6379

# Storage: local | s3
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=.waveyard-data/objects
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=waveyard
S3_ACCESS_KEY=waveyard
S3_SECRET_KEY=waveyard-local-development-only
S3_FORCE_PATH_STYLE=true

# Audio and worker
MAX_UPLOAD_BYTES=524288000
SEPARATION_ENGINE=demucs
SEPARATION_MODEL=htdemucs
STEM_DEVICE=auto
PYTHON_BIN=python3
WORKER_CONCURRENCY=1

# Optional one-time comma-separated bootstrap allowlist. Matching accounts receive
# the persisted moderator role at registration; remove after creating staff.
WAVEYARD_INITIAL_MODERATOR_EMAILS=
