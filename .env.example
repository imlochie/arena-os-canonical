# Required by the currently preserved Next.js / PostgreSQL implementation.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/arena

# Current legacy runtime controls. Do not place provider credentials in this file.
# FORCE_LOCAL_MODE=1
# SEAL_SECRET=replace-with-a-long-random-value

# Optional, self-hosted stem separation adapter. Arena forwards work only when
# this URL points to a real worker implementing GET /health and POST /v1/separations.
# STEM_WORKER_URL=http://your-local-stem-worker:8080
# STEM_MAX_UPLOAD_BYTES=524288000

# Reserved for the canonical provider configuration (not implemented yet).
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# REDIS_URL=redis://localhost:6379
# STORAGE_ENDPOINT=
# STORAGE_BUCKET=arena
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=
