# Required by the currently preserved Next.js / PostgreSQL implementation.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/arena

# Current legacy runtime controls. Do not place provider credentials in this file.
# FORCE_LOCAL_MODE=1
# SEAL_SECRET=replace-with-a-long-random-value

# Stem Lab can use either an explicitly configured external worker adapter or
# Arena's durable queue/storage pipeline. Do not enable both modes by accident.
# External worker adapter (GET /health and POST /v1/separations):
# STEM_WORKER_URL=http://your-local-stem-worker:8080
#
# Arena-owned durable pipeline (the docker-compose.yml development defaults):
# STEM_PIPELINE_ENABLED=true
# REDIS_URL=redis://127.0.0.1:6379
# STEM_STORAGE_PROVIDER=local # or s3
# STEM_LOCAL_STORAGE_PATH=.arena-data/stem-objects
# STEM_S3_ENDPOINT=http://127.0.0.1:9000
# STEM_S3_REGION=us-east-1
# STEM_S3_BUCKET=arena-stems
# STEM_S3_ACCESS_KEY=arena
# STEM_S3_SECRET_KEY=arena-local-development-only
# STEM_S3_FORCE_PATH_STYLE=true
# STEM_MODEL=htdemucs
# STEM_DEVICE=auto # auto, cpu, or cuda; CUDA needs a compatible worker image/runtime
# STEM_WORKER_CONCURRENCY=1
# STEM_MAX_UPLOAD_BYTES=524288000

# Reserved for the canonical provider configuration (not implemented yet).
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# REDIS_URL=redis://localhost:6379
# STORAGE_ENDPOINT=
# STORAGE_BUCKET=arena
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=
