# Local defaults — copy to .env (or run `npm run dev` once; it does this).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Waveyard worker (optional). Without REDIS_URL, the app runs fine and every
# worker-gated feature (separation, analysis, export) reports honestly as
# unavailable. With Redis + the waveyard-worker running, those features are
# real. The docker-compose.yml at the repo root starts everything at once.
# REDIS_URL=redis://127.0.0.1:6379

# Separation defaults (used when a client does not specify them).
# htdemucs is the portable default; the worker supports the Demucs family.
# SEPARATION_MODEL=htdemucs
# STEM_DEVICE=cpu

# Where the web app stores Waveyard source/stem/waveform/export files.
# The worker (original packages/storage) knows this variable as
# LOCAL_STORAGE_PATH; both names are accepted. In docker compose both
# containers share one volume at /app/.data/waveyard-storage.
# WAVEYARD_STORAGE_DIR=.data/waveyard-storage

# Archive Assistant is MERGED into Arena OS (native, no external app, no
# bridge URL). Connect Plex/Jellyfin from /rooms/archive-assistant — tokens
# are sealed in the local database. Nothing to configure here.

# ---------------------------------------------------------------------------
# AI providers (chat, battles, analysis). Without keys, everything still runs
# on the deterministic Local Engine and every answer says so.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=        # custom OpenAI-compatible endpoint
# OPENAI_MODEL=           # default model id for the OpenAI provider
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=
# ANTHROPIC_MODEL=

# ---------------------------------------------------------------------------
# Visual studio backends (/studio). Unset = Demo backend (procedural previews,
# clearly labeled — never presented as model output).
# WANGP_BRIDGE_URL=       # local WanGP bridge (bridges/wangp_bridge.py)
# COMFYUI_URL=            # any ComfyUI server
# TURBOAGENT_URL=         # TurboAgent endpoint (or set per-browser via the keys bar)

# ---------------------------------------------------------------------------
# Personalisation evidence seam (optional, UNWIRED since the merge; kept as
# validated scaffolding for future native watch-state evidence).
# ARCHIVE_ASSISTANT_AUTH_MODE=bearer
# ARCHIVE_ASSISTANT_BEARER_TOKEN=
# ARCHIVE_ASSISTANT_OWNER_ID=

# ---------------------------------------------------------------------------
# College runtime.
# COLLEGE_AUTH_MODE=      # unset = local single-user (the default); any other
#                         # value requires real authentication upstream
# COLLEGE_MODEL_ID=       # model used for class execution (default in code)

# ---------------------------------------------------------------------------
# Operational.
# ARENA_APP_URL=          # target for scripts/spaces-daemon.mjs (default http://127.0.0.1:3000)
# ARENA_INTERNAL_API_KEY= # server-only shared secret enabling /api/internal/* service routes
# SEAL_SECRET=            # secret for sealing reveal payloads (defaults to DATABASE_URL locally)
# PYTHON_BIN=             # python interpreter for bridge tooling (default: python3)
# FORCE_LOCAL_MODE=1      # force every execution to the Local Engine (offline demo)

# ---------------------------------------------------------------------------
# Waveyard tuning (defaults in code; all optional).
# MAX_UPLOAD_BYTES=524288000        # 500 MB upload ceiling
# MAX_WAVEFORM_PCM_BYTES=…          # cap on derived waveform PCM reads
# WAVEYARD_MODELS_DIR=.data/waveyard-models
# AUTHORIZED_SOURCE_RESOLVER_URL=   # authorized-source acquisition service; unset = feature disabled

# ---------------------------------------------------------------------------
# Desktop packaging (set automatically by the Electron runtime — never hand-set).
# ARENA_DESKTOP_MODE=1

# --- Model Hub (local runtimes + agent bridge) ---
# Optional: require this shared secret on /api/agent-bridge routes (the bridge
# CLI passes it as x-arena-internal-key). Leave unset for loopback-only dev.
# ARENA_INTERNAL_API_KEY=change-me
# Optional: allow connecting Model Hub runtimes on LAN addresses (192.168.x.x,
# 10.x.x.x, 172.16-31.x.x). Loopback (127.0.0.1/localhost/::1) always works.
# MODEL_HUB_ALLOW_LAN=1

