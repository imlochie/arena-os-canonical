# ── Archive Assistant read-only bridge ─────────────────────────────────────
# Server-only variables. Never prefix with NEXT_PUBLIC_ — the browser must
# not call Archive Assistant directly; Arena's /api/archive/* routes call it
# server-to-server. See docs/archive-assistant-integration.md.

# REQUIRED to enable the bridge. Base URL of the Archive Assistant HTTP API
# (the Express API mounts at /api). There is deliberately NO default and no
# localhost fallback: without this the routes answer 503
# (archive_assistant_not_configured) instead of guessing a service.
ARCHIVE_ASSISTANT_API_URL=https://archive-assistant.example.com/api

# Authentication forwarding mode.
#   bearer (default, production) — forward the authenticated Arena user's
#     bearer token server-to-server; Archive Assistant validates it (Clerk)
#     and derives the owner from the authenticated identity.
#   local (development only) — use when Archive Assistant itself runs in
#     AUTH_MODE=local; the owner is a server-configured constant, never
#     taken from the client.
ARCHIVE_ASSISTANT_AUTH_MODE=bearer

# Local development only (never set in production):
# ARCHIVE_ASSISTANT_AUTH_MODE=local
# ARCHIVE_ASSISTANT_OWNER_ID=__local__

# Per-request bounded timeout in ms (default 15000, max 120000).
# ARCHIVE_ASSISTANT_TIMEOUT_MS=15000
