# The College
DATABASE_URL="postgresql://user:pass@host:5432/app_db"

# AUTHENTICATION MODE — set this to "strict" for ANY deployment.
#
# Unset (development): requests from loopback are granted control_room
# authority without a token, so local work needs no ceremony.
#
# "strict": no request is privileged by origin. Every caller must present
# a paired device token. This MUST be set the moment the College is
# reachable from anything other than your own machine.
COLLEGE_AUTH_MODE="strict"

# Optional
COLLEGE_MODEL_ID="openai"
SEAL_SECRET=""
