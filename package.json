{
  "name": "nextjs-postgresql-template",
  "private": true,
  "scripts": {
    "predev": "node scripts/ensure-env.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/ensure-env.mjs",
    "build": "next build",
    "prestart": "node scripts/ensure-env.mjs",
    "start": "next start",
    "lint": "eslint . --cache",
    "db:setup": "node scripts/db-setup.mjs",
    "typecheck": "node scripts/typecheck.mjs",
    "test": "node --import ./scripts/register-src-loader.mjs --test \"src/**/*.test.ts\" \"desktop/**/*.test.ts\" \"scripts/lib/*.test.mjs\"",
    "test:acceptance:a7": "node --import ./scripts/register-src-loader.mjs --test \"tests/acceptance/a7-real-runtime.test.ts\"",
    "test:desktop": "node --import ./scripts/register-src-loader.mjs --test \"desktop/**/*.test.ts\" \"src/lib/waveyard/worker-local/*.test.ts\"",
    "smoke:archive": "node --import ./scripts/register-src-loader.mjs scripts/archive-context-smoke.ts",
    "desktop:compile": "tsc -p desktop/tsconfig.json",
    "desktop": "npm run desktop:compile && electron .",
    "desktop:smoke": "node scripts/desktop-smoke.mjs",
    "desktop:e2e": "node --import ./scripts/register-src-loader.mjs scripts/desktop-e2e.mjs",
    "desktop:prepare-server": "node scripts/desktop-prepare-server.mjs",
    "desktop:dist": "npm run desktop:compile && npm run desktop:prepare-server && node scripts/desktop-dist.mjs",
    "desktop:acceptance-headless": "node --import ./scripts/register-src-loader.mjs scripts/desktop-acceptance-headless.mjs",
    "windows:acceptance": "node scripts/windows-acceptance.mjs",
    "test:acceptance:music": "node scripts/waveyard-real-music.mjs",
    "test:acceptance:handoff": "node --import ./scripts/register-src-loader.mjs --test src/lib/waveyard/library/service.test.ts",
    "test:acceptance:transport": "node --test tests/acceptance/stem-transport.test.mjs",
    "test:acceptance:session": "node --test tests/acceptance/session-runtime.test.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@mlc-ai/web-llm": "^0.2.85",
    "@simplewebauthn/server": "^14.0.3",
    "@types/mailparser": "^3.9.0",
    "bullmq": "^6.3.12",
    "dotenv": "17.3.1",
    "drizzle-orm": "0.45.2",
    "imapflow": "^2.4.0",
    "ioredis": "^6.0.0",
    "lucide-react": "^1.55.0",
    "mailparser": "^3.9.38",
    "msedge-tts": "^2.0.9",
    "next": "^16.3.8",
    "onnxruntime-node": "^1.30.0",
    "pg": "8.20.0",
    "playwright-core": "^1.64.0",
    "pptxgenjs": "^4.0.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "semver": "^7.8.5",
    "zod": "^3.25.76",
    "zustand": "^5.0.15"
  },
  "optionalDependencies": {
    "@embedded-postgres/darwin-arm64": "16.14.0-beta.17",
    "@embedded-postgres/darwin-x64": "16.14.0-beta.17",
    "@embedded-postgres/linux-arm64": "16.14.0-beta.17",
    "@embedded-postgres/windows-x64": "16.14.0-beta.17"
  },
  "devDependencies": {
    "@embedded-postgres/linux-x64": "16.14.0-beta.17",
    "@ffmpeg-installer/linux-x64": "^4.1.0",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "4.1.17",
    "@types/node": "22.19.15",
    "@types/pg": "8.18.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.12",
    "eslint": "9.39.4",
    "eslint-config-next": "^16.3.8",
    "ffprobe-installer": "^2.1.5",
    "postcss": "8.5.8",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3"
  },
  "version": "0.1.0",
  "description": "Arena — local-first music production workspace",
  "author": "Arena",
  "main": "desktop/dist/main.js",
  "engines": {
    "node": ">=22"
  },
  "allowScripts": {
    "@embedded-postgres/darwin-arm64@16.14.0-beta.17": true,
    "@embedded-postgres/darwin-x64@16.14.0-beta.17": true,
    "@embedded-postgres/linux-arm64@16.14.0-beta.17": true,
    "@embedded-postgres/linux-x64@16.14.0-beta.17": true,
    "@embedded-postgres/windows-x64@16.14.0-beta.17": true,
    "@ffmpeg-installer/linux-x64@4.1.0": true,
    "@ffprobe-installer/linux-x64@5.2.0": true,
    "electron-winstaller@5.4.0": true,
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true,
    "msedge-tts": false,
    "msgpackr-extract": false,
    "onnxruntime-node": false
  }
}
