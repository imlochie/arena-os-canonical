{
  "name": "nextjs-postgresql-template",
  "version": "0.1.0",
  "description": "Arena — local-first music production workspace",
  "author": "Arena",
  "private": true,
  "scripts": {
    "predev": "node scripts/ensure-env.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/ensure-env.mjs",
    "build": "next build",
    "prestart": "node scripts/ensure-env.mjs",
    "start": "next start",
    "lint": "eslint .",
    "db:setup": "node scripts/db-setup.mjs",
    "typecheck": "node scripts/typecheck.mjs",
    "test": "node --import ./scripts/register-src-loader.mjs --test \"src/**/*.test.ts\" \"desktop/**/*.test.ts\"",
    "smoke:archive": "node --import ./scripts/register-src-loader.mjs scripts/archive-context-smoke.ts",
    "desktop:compile": "tsc -p desktop/tsconfig.json",
    "desktop": "npm run desktop:compile && electron .",
    "desktop:smoke": "node scripts/desktop-smoke.mjs",
    "desktop:prepare-server": "node scripts/desktop-prepare-server.mjs",
    "desktop:dist": "npm run desktop:compile && npm run desktop:prepare-server && node scripts/desktop-dist.mjs",
    "desktop:e2e": "node --import ./scripts/register-src-loader.mjs scripts/desktop-e2e.mjs",
    "test:desktop": "node --import ./scripts/register-src-loader.mjs --test \"desktop/**/*.test.ts\" \"src/lib/waveyard/worker-local/*.test.ts\"",
    "desktop:acceptance-headless": "node --import ./scripts/register-src-loader.mjs scripts/desktop-acceptance-headless.mjs",
    "windows:acceptance": "node --import ./scripts/register-src-loader.mjs scripts/windows-acceptance.mjs"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@mlc-ai/web-llm": "^0.2.85",
    "bullmq": "^6.3.11",
    "dotenv": "17.3.1",
    "drizzle-orm": "0.45.2",
    "ioredis": "^6.0.0",
    "lucide-react": "^1.52.0",
    "next": "^16.3.8",
    "pg": "8.20.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@simplewebauthn/server": "^13.3.3",
    "@tailwindcss/postcss": "4.1.17",
    "@types/node": "22.19.15",
    "@types/pg": "8.18.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "electron": "^44.5.1",
    "electron-builder": "^26.0.12",
    "eslint": "9.39.4",
    "eslint-config-next": "^16.3.8",
    "postcss": "^8.5.29",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3"
  },
  "main": "desktop/dist/main.js",
  "optionalDependencies": {
    "@embedded-postgres/linux-x64": "^16.14.0-beta.17",
    "@embedded-postgres/windows-x64": "^16.14.0-beta.17"
  },
  "allowScripts": {
    "@embedded-postgres/linux-x64": true,
    "@embedded-postgres/windows-x64": true,
    "@ffmpeg-installer/linux-x64": true,
    "@ffmpeg-installer/win32-x64": true,
    "@ffprobe-installer/linux-x64": true,
    "@ffprobe-installer/win32-x64": true,
    "esbuild": true,
    "msgpackr-extract": true,
    "unrs-resolver": true,
    "electron-winstaller": false
  }
}
