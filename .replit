modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "test && pnpm --filter @workspace/scripts exec tsx --test $PWD/lib/arena/src/lib/waveyard/session-output.test.ts && node scripts/waveyard-live-stems.mjs --session-output-recovery-only"

[[workflows.workflow]]
name = "test"
author = "agent"

[workflows.workflow.metadata]
isValidation = true


[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000

[nix]
channel = "stable-25_05"
packages = ["wineWowPackages.stable", "bubblewrap", "xorg.xorgserver", "xorg.xdpyinfo", "xdotool", "icu74", "libjpeg_turbo", "gst_all_1.gstreamer", "gst_all_1.gst-plugins-base", "gst_all_1.gst-plugins-bad", "libsecret", "hyphen", "woff2", "patchelf", "libjpeg8", "gtk4", "pango", "harfbuzz", "gdk-pixbuf", "cairo", "vulkan-loader", "graphene", "libxml2", "sqlite", "libxslt", "lcms2", "libevent", "libopus", "flite", "libwebp", "libavif", "wayland", "libmanette", "mesa", "enchant", "atk", "libxkbcommon", "libGL", "x264", "gcc", "libglvnd", "libjxl", "libsoup_3", "gst_all_1.gst-plugins-good"]
