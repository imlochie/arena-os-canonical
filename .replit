modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "test && pnpm --filter @workspace/scripts exec tsx --test $PWD/lib/arena/src/lib/waveyard/session-output.test.ts && node scripts/waveyard-live-stems.mjs --session-output-recovery-only"

[[workflows.workflow]]
name = "test"
author = "agent"

[workflows.workflow.metadata]
isValidation = true


[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000

[nix]
channel = "stable-25_05"
packages = ["alsa-lib", "atk", "bubblewrap", "cairo", "enchant", "ffmpeg-full", "flite", "gcc", "gdk-pixbuf", "graphene", "gst_all_1.gst-plugins-bad", "gst_all_1.gst-plugins-base", "gst_all_1.gst-plugins-good", "gst_all_1.gstreamer", "gtk3", "gtk4", "harfbuzz", "hyphen", "icu74", "lcms2", "libGL", "libavif", "libevent", "libglvnd", "libjpeg8", "libjpeg_turbo", "libjxl", "libmanette", "libopus", "libsecret", "libsoup_3", "libwebp", "libxkbcommon", "libxml2", "libxslt", "mesa", "pango", "patchelf", "sqlite", "vulkan-loader", "wayland", "wineWowPackages.stable", "woff2", "x264", "xdotool", "xorg.libXcomposite", "xorg.libXcursor", "xorg.libXdamage", "xorg.libXfixes", "xorg.libXi", "xorg.libXrandr", "xorg.xdpyinfo", "xorg.xorgserver"]
