modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "test"

[[workflows.workflow]]
name = "test"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node scripts/arena-smoke.mjs && pnpm --filter @workspace/scripts exec tsx --test $PWD/scripts/waveyard-studio-recovery-accessibility.test.ts && pnpm --filter @workspace/scripts exec tsx --test $PWD/lib/arena/src/lib/waveyard/live-stem-layers.test.ts && node scripts/waveyard-live-stems.mjs --studio-persistence-only && node scripts/waveyard-live-stems.mjs --live-stem-timing-matrix"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000

[nix]
channel = "stable-25_05"
packages = ["wineWowPackages.stable", "bubblewrap", "xorg.xorgserver", "xorg.xdpyinfo", "xdotool"]
