# Electron's binary is NOT fetched by npm install (electron 44 ships no
# install script); it is hydrated lazily into node_modules/electron/dist on
# first run. In restricted networks skip that entirely with the SUPPORTED
# environment variable:
#   ELECTRON_SKIP_BINARY_DOWNLOAD=1 npm install
# (The old `electron_skip_binary_download=true` key here was never a real
# npm config and warned on every modern npm command — removed.)

# npm >= 11.16 / 12: fail installs whose dependency scripts are not covered
# by the "allowScripts" allowlist in package.json. Older npm ignores this.
strict-allow-scripts=true
