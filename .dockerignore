# Keep the web image build context small and reproducible.
node_modules
.next
.data
.env
.env.local
.env.*.local
.git
.gitignore
*.log
tsconfig.tsbuildinfo

# The worker image builds from ./waveyard-worker with its own context; the
# web uses the canonical DSP and its shared type-only helpers.
waveyard-worker/*
!waveyard-worker/packages/
waveyard-worker/packages/*
!waveyard-worker/packages/dsp/
!waveyard-worker/packages/types/
**/node_modules

# Never bake user media into an image
uploads
